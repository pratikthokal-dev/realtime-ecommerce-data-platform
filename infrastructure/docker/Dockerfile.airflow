FROM apache/airflow:2.10.5

USER root

# Install Java 17 for Spark
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Java environment
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Apache Spark provider for Airflow
RUN pip install --no-cache-dir --no-deps \
    apache-airflow-providers-apache-spark==5.2.1

# Required compatibility provider
RUN pip install --no-cache-dir --no-deps \
    apache-airflow-providers-common-compat==1.5.0

# PySpark aligned with the Spark 4.0.1 containers
RUN pip install --no-cache-dir --no-deps \
    pyspark==4.0.1

# Py4J dependency used by PySpark
RUN pip install --no-cache-dir \
    py4j==0.10.9.9

# Great Expectations for data-quality validation
RUN pip install --no-cache-dir \
    great-expectations==1.22.0

USER root

RUN mkdir -p /opt/airflow/jars && \
    curl -fL --retry 3 \
    -o /opt/airflow/jars/iceberg-spark-runtime-4.0_2.13-1.10.1.jar \
    https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-4.0_2.13/1.10.1/iceberg-spark-runtime-4.0_2.13-1.10.1.jar

USER airflow